    {
      "label": "ruff: format",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "format", "."],
      "problemMatcher": []
    },
    {
      "label": "pytest",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest"],
      "problemMatcher": []
    }
  ]
}
